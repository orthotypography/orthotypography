{
  "name": "@orthotypography/core",
  "version": "0.2.0-alpha.0",
  "license": "MIT",
  "lock": false,
  "exports": {
    ".": "./src/mod.ts",
    "./catalogue": "./src/catalogue/mod.ts",
    "./registry": "./src/registry/mod.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "RELEASING.md",
      "docs/**/*.md",
      "src/**/*.ts"
    ]
  },
  "exclude": [
    "npm/",
    "scripts/npm_smoke.mjs"
  ],
  "fmt": {
    "include": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      ".github/**/*.yml",
      "*.json"
    ],
    "exclude": [
      "tests/fixtures/"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task doc && deno task matrix:check",
    "matrix": "deno run --allow-read --allow-write=docs/matrice-couverture-in-2002-v0.1.md scripts/coverage_matrix.ts",
    "matrix:check": "deno run --allow-read scripts/coverage_matrix.ts --check",
    "doc": "deno doc src/mod.ts src/catalogue/mod.ts src/registry/mod.ts",
    "test": "deno test --allow-read=tests",
    "corpus:update": "deno run --allow-read=tests/fixtures --allow-write=tests/fixtures/corpus/snapshots.json tests/support/corpus.ts",
    "bench": "deno run --allow-read=tests/fixtures scripts/benchmark.ts",
    "publish:check": "deno publish --dry-run --check=all",
    "npm:build": "deno run -A scripts/build_npm.ts",
    "npm:check": "deno task npm:build && node scripts/npm_smoke.mjs && cd npm && npm pack --dry-run",
    "currency:update": "deno run --allow-net=www.six-group.com --allow-read --allow-write=src/registry/currency-data.ts,docs/iso-4217-update.md scripts/update_iso4217.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@0.43.2"
  }
}
